{
  "name": "milo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "慢牛 Milo：自适应训练处方（Android APK via Capacitor；Web 预览部署在 Vercel）",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy_static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:hardcoded": "node scripts/check_hardcoded.mjs",
    "check": "npm run typecheck && npm test && npm run check:hardcoded && npm run build",
    "android:sync": "cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "shots:playground": "python3 scripts/shoot_playground.py",
    "shots:hifi": "python3 scripts/shoot_hifi.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
