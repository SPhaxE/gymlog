{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/public/:path*", "destination": "/:path*" },
    { "source": "/((?!prototype/|design/|mock/|exercises/|bodymap/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/exercises/clips/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/prototype/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/mock/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
