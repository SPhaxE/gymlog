{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/", "destination": "/prototype/", "permanent": false }],
  "headers": [
    { "source": "/public/exercises/clips/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/prototype/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/mock/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
